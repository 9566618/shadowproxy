config conf main
    option enabled '0'
    option socks_port '1080'
    option http_port '1081'
    option redir_port '60080'
    option dns_port '5300'
    option dns_remote_addr '1.1.1.1'
    option dns_local_addr '223.5.5.5'

config server
    option enabled '1'
    option server '45.32.222.22'
    option server_port '8388'
    option password 'barfoo!'
    option method 'rc4-md5'

config server
    option enabled '0'
    option server '2001:19f0:5001:46b:4:3:2:1'
    option server_port '8388'
    option password 'barfoo!'
    option method 'rc4-md5'

config conf settings
    # 建议设为 CPU 核数。设得远高于核数只会增加线程栈和调度开销:
    # 64 个 worker 在 4 核路由器上会多占约 500MB 虚拟内存，吞吐并不会变高
    option worker_count '4'
    option client_cache_size '64'
    # TCP_NODELAY: 关掉 Nagle，小包不再被攒 40ms，改善视频分片请求和交互延迟
    option no_delay '1'
    option keep_alive 15
    option nofile '10240'
    option fast_open '0'
    option mptcp '0'
    list allowed_udp_port '80'
    list allowed_udp_port '443'
